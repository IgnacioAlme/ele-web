# URL base del Moodle (opcional, por defecto https://ele.chaco.gob.ar)
MOODLE_URL=https://ele.chaco.gob.ar

# Token de Web Services del Moodle.
# Copiar este archivo como .env.local y completar el valor. NUNCA commitear .env.local
# (ya está en .gitignore). En Vercel se configura en Settings → Environment Variables.
MOODLE_TOKEN=